{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ppa-phoenixpixarena",
  "compatibility_date": "2026-09-17",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ppa-phoenix-db",
      "database_id": "53d15b19-362d-4850-a6b8-df058ac1fba7"
    }
  ]
}
